{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Versátil: desarrollar",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "versatil",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "Versátil: servidor de desarrollo activo en puerto [0-9]+"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Versátil: revisar sintaxis",
      "type": "npm",
      "script": "check",
      "problemMatcher": []
    },
    {
      "label": "Versátil: pruebas",
      "type": "npm",
      "script": "test",
      "problemMatcher": []
    },
    {
      "label": "Versátil: verificar todo",
      "dependsOn": ["Versátil: revisar sintaxis", "Versátil: pruebas"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
